@model Lists.Models.View.ExistingCredentials
<div class="defaultText">Credentials:</div>
<br />
<div class="dataViewWrapper">
    <table class="dataView">
        <tr class="dataViewRow">
            <td class="dataLabel">Username:</td>
            <td class="dataValue">@Model.Username</td>
        </tr>
        <tr class="dataViewRow">
            <td class="dataLabel">Pattern:</td>
            <td class="dataValue">XXXXXXXXXXXXXXXXX</td>
        </tr>
    </table>
</div>
<br />
<br />
<button class="button" onclick="edit('creds')">Edit</button>
<script type="text/javascript">

    function handleEditCredentialsOnSuccess(data, textStatus, jqXHR) {
        hideLoader();
        $("#credentials").html(data);
    }
</script>