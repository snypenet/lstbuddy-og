@model Lists.Models.View.EditCredentials
<br />
<div class="sectionLabel">Edit Credentials</div>
@using (Ajax.BeginForm("SaveCredentials", new AjaxOptions()
{
    OnBegin = "showLoader()",
    OnSuccess = "handleEditCredentialsOnSuccess"
}))
{
    @Html.ValidationSummary()
    @Html.TextBoxFor(x => x.Username, new { placeholder = "Username", @class="text" })<br />
    <img class="refreshicon" src="@Url.Content("~/Images/refresh.png")" onclick="resetGrid()" />
    <br />
    <div id="mainGridAuth" class="gridAuth"></div>
    @Html.HiddenFor(x => x.Pattern)
    <br />
    <div class="buttons">
        <button type="submit" class="button submitButton">Save</button>
        <button type="button" onclick="clearForm(this)" class="button">Clear</button>
        <button type="button" class="button cancelButton">Cancel</button>
    </div>
}
<script type="text/javascript">
    $(function () {
        authGrid.createGrid({
            gridContainer: $("#mainGridAuth"),
            patternContainer: $("#Pattern")
        });

        if ("@Model.Pattern".length > 0) {
            authGrid.setPattern("@Model.Pattern");
        }
        $(".cancelButton").click(function () {
            $("#credentials").load("@Html.Raw(Url.Action("LoadView", "Profile", new { type = "creds" }))");
        });
    });
</script>