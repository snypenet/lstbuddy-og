@model List<Lists.Models.Data.PersonSearchResult>

@if (Model != null && Model.Any())
{
    <div class="searchResultsContainer">
        @foreach (var result in Model)
        {
            <div class="personSearchResult actualResult" data-id="@result.Id">
                @result.FullName
            </div>
        }
    </div>
    <script type="text/javascript">
        $(function () {
            $(".actualResult").click(function () {
                $("#autocompleteName").val($.trim($(this).text()));
                $("#PersonId").val($(this).attr("data-id"));
                $("#autoCompleteResults").empty();
            });
        });
    </script>
}
else
{
    <div class="searchResultsContainer">
        <div class="personSearchResult">
            No results found
        </div>
    </div>
}

