@model Lists.Models.View.Credentials
@using (Ajax.BeginForm("Login", new AjaxOptions()
{
    OnBegin = "showLoader()",
    OnSuccess = "handleOnSuccess"
}))
{
    @Html.ValidationSummary()<br />
    @Html.TextBoxFor(x => x.Username, new { @class = "text", placeholder = "Username" })<br />
    <img class="refreshicon" src="@Url.Content("~/Images/refresh.png")" onclick="resetGrid()" />
    <br />
    <div id="mainGridAuth" class="gridAuth"></div>
    @Html.HiddenFor(x => x.Pattern)
    <br />
    <div class="buttons">
        <button type="submit" class="button submitButton">Login</button>
        <button type="button" class="button clearButton" onclick="clearForm(this)">Clear</button>
        <button type="button" class="button" onclick="window.location.href='@Url.Action("Index", "Register")'">Sign Up</button>
    </div>
}
<script type="text/javascript">
    $(function () {
        authGrid.createGrid({
            gridContainer: $("#mainGridAuth"),
            patternContainer: $("#Pattern")
        });

        if ("@Model.Pattern".length > 0) {
            authGrid.setPattern("@Model.Pattern");
        }
    });

    function resetGrid() { 
        authGrid.reset();
    }
</script>