@model Lists.Models.Data.ListItem

<br />
<div class="defaultText">
    Are you sure you want to delete this item '@Model.Text'?
</div>
<br /><br />
<button class="button" id="yesButton">Yes</button>
<button class="button" id="noButton">No</button>

<script type="text/javascript">
    $(function () {
        $("#yesButton").click(function () {
            window.location.href = "@Url.Action("Delete", "Lists", new { id = Model.Id })";
        });

        $("#noButton").click(function () {
            window.location.href = "@Url.Action("CancelAction", "Lists", new { id = Model.Id })";
        });
    });
</script>