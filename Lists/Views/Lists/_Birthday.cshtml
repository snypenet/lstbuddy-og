@model Lists.Models.Data.List

<div class="listTitle defaultText">@Model.Name</div>
<div class="listOwner defaultText">Owner: @string.Format("{0} {1}", Model.Owner.FirstName, Model.Owner.LastName)</div>
@Html.Partial("_ShareOnFacebook", Model.ShareId)
@if (Model.ExpiresOn.HasValue)
{
    <div class="listExpiration defaultText">Expires: @Model.ExpiresOn.Value.ToShortDateString()</div>
}

<div id="birthdayListItems" class="listItems">
    @Html.Partial("_BirthdayListItems", Model.Items)
</div>
@if ((Model.Editors.Contains(((Lists.Models.Data.Person)ViewBag.CurrentUser).Id) ||
    Model.Owner.Id == ((Lists.Models.Data.Person)ViewBag.CurrentUser).Id) && !Model.IsExpired)
{
    <hr />
    <div id="listItemAdd">
    @Html.Partial("_NewBirthdayListItem", new Lists.Models.View.NewBirthdayListItem
    {
        ListId = Model.Id
    })
</div>
}
