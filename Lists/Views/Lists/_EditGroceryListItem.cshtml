@model Lists.Models.View.EditGroceryListItem
<br />
<div class="sectionLabel">Edit List item</div>
@using (Ajax.BeginForm("SaveGroceryItem", new AjaxOptions()
{
    OnBegin = "showLoader()",
    OnSuccess = "handleEditOnSuccess"
}))
{
    @Html.ValidationSummary()
    @Html.DropDownList("QuickAdd", Model.QuickAdd.Select(item => new SelectListItem { Text = item, Value = item }), "Quick Add", new { id = "QuickAdd" })
    <br /><br />
    @Html.TextBoxFor(x => x.Text, new { placeholder = "Item Text" })<br />
    <span class="defaultText">Quantity: <span id="quantityEditValue">@Model.Quantity</span></span>
    <text>&nbsp;&nbsp;&nbsp;</text>
    <button class="button" id="incrementEdit" type="button">+</button>
    <text>&nbsp;</text>
    <button class="button" id="decrementEdit" type="button">-</button>
    @Html.TextBoxFor(x => x.Price, new { type="number", step="any", placeholder = "$ Price" })
    @Html.TextBoxFor(x => x.Url, new { placeholder = "URL" })
    @Html.HiddenFor(x => x.Id)
    @Html.HiddenFor(x => x.Quantity)
    <br />
    <div class="buttons">
        <button type="submit" class="button submitButton">Save</button>
        <button type="button" id="cancelButton" class="button">Cancel</button>
    </div>
}
<script type="text/javascript">
    $(function () {
        $("#QuickAdd").change(function () {
            if ($(this).val()) {
                var previousValue = $("#Text").val();
                $("#Text").val($(this).val()).attr("data-prev", previousValue);
            } else {
                $("#Text").val($("#Text").attr("data-prev")).removeAttr("data-prev");
            }
        });
        $("#cancelButton").click(function () {
            $(this).closest(".editListItem").remove();
        });

        $("#incrementEdit").click(function () {
            var quantity = Number($("#quantityEditValue").text());
            $("#quantityEditValue").html(quantity + 1);
            $(this).closest("form").find("#Quantity").val(quantity + 1);
        });

        $("#decrementEdit").click(function () {
            var quantity = Number($("#quantityEditValue").text());
            if (quantity - 1 > 0) {
                $("#quantityEditValue").html(quantity - 1);
                $(this).closest("form").find("#Quantity").val(quantity - 1);
            }
        });
    });
   
</script>